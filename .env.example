# TestRunner Pro - Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e personalize conforme seu ambiente:
# cp .env.example .env

APP_NAME="TestRunner Pro"
DATABASE_URL="sqlite+aiosqlite:///./testrunner.db"
DEBUG=True

# Configurações padrão do executor
DEFAULT_BROWSER="chromium"
DEFAULT_HEADLESS=True
DEFAULT_TIMEOUT=30000
REPORTS_DIR="./reports"
