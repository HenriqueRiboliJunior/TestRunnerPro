# ==========================================
# TestRunner Pro - .gitignore
# ==========================================

# --- Segredos & Variáveis de Ambiente ---
.env
.env.*
!.env.example
*.env
secrets/
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
client_secret*.json
serviceAccountKey*.json
*.token

# --- Playwright Autenticação & Estado de Sessão ---
.auth/
auth/
*state.json
*auth.json

# --- Banco de Dados Local ---
testrunner.db
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Ambientes Virtuais ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Python Cache & Compilados ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Relatórios e Artefatos de Testes ---
reports/*
!reports/.gitkeep
test-results/
playwright-report/
blob-report/
playwright/.cache/
output.xml
log.html
report.html
traces/
videos/
screenshots/

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Dependências Node (se utilizadas) ---
node_modules/

# --- IDEs & Editores ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Arquivos de Sistema Operacional ---
.DS_Store
.DS_Store?
._*
[Tt]humbs.db
[Ee]hthumbs.db
[Dd]esktop.ini

# --- Temporários ---
tmp/
temp/